{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/prune-memory.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
